# MySQL — match your local or production database
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=your_database_name

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_random_32+_character_secret

# Admin login — email + password only
ADMIN_PASSWORD=change_this_password
ADMIN_EMAIL=admin@example.com

# SMTP — email provider credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM="Your Company Name <your_email@gmail.com>"

# Public URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000